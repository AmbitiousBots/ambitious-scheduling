{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasks snapshot, version 1",
  "description": "The tasks a bot read from a task module at one moment, passed to another module as data. The rows are the task module's own list rows. A reader ignores fields it does not know. The snapshot digest is the SHA-256, in lowercase hex, of the canonical JSON of the list of [id, updated_at] pairs sorted by id; a reader computes it and, when digest is present, refuses a snapshot whose digest differs.",
  "type": "object",
  "required": ["schema", "tasks"],
  "properties": {
    "schema": { "const": "tasks-snapshot.v1" },
    "taken_at": { "$ref": "#/$defs/instant" },
    "list": { "type": "string", "minLength": 1 },
    "digest": { "$ref": "#/$defs/sha256" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableText": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "task": {
      "type": "object",
      "required": ["id", "title", "status", "updated_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "list": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["todo", "in_progress", "blocked", "waiting", "done", "canceled"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 3 },
        "estimate_days": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
        "due": { "$ref": "#/$defs/nullableText" },
        "assignee": { "$ref": "#/$defs/nullableText" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "updated_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
