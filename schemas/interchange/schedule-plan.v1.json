{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schedule plan, version 1",
  "description": "A proposed or committed placement of tasks into blocks of time on calendars. Every instant is UTC with a Z. digest is the SHA-256, in lowercase hex, of the canonical JSON of { horizon, policy, tasks_digest, busy_digest, blocks } with blocks sorted by start, calendar_id, task_id and seq. A plan version is never edited: a change is a new version of the same plan_id, and a copy under a new plan_id names where it came from in forked_from.",
  "type": "object",
  "required": ["schema", "horizon", "tasks_digest", "blocks", "digest"],
  "properties": {
    "schema": { "const": "schedule-plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 0 },
    "forked_from": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["plan_id", "version"],
          "properties": { "plan_id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 } }
        }
      ]
    },
    "status": { "enum": ["proposed", "committed"] },
    "horizon": {
      "type": "object",
      "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/utc" }, "end": { "$ref": "#/$defs/utc" } }
    },
    "policy": { "type": "object" },
    "tasks_digest": { "$ref": "#/$defs/sha256" },
    "busy_digest": { "$ref": "#/$defs/sha256" },
    "tzdata": { "type": "string" },
    "solver": { "enum": ["greedy", "constraints"] },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "unscheduled": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "code", "message"],
        "properties": { "task_id": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } }
      }
    },
    "digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "block": {
      "type": "object",
      "required": ["task_id", "calendar_id", "seq", "start", "end"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "calendar_id": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "start": { "$ref": "#/$defs/utc" },
        "end": { "$ref": "#/$defs/utc" },
        "local_start": { "type": "string" },
        "local_end": { "type": "string" },
        "tz": { "type": "string" }
      }
    }
  }
}
